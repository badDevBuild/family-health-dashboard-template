{
  "name": "family-health-dashboard-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-data": "node scripts/generate-data.mjs",
    "generate-demo-data": "HEALTH_DATA_DIR=examples/demo-data node scripts/generate-data.mjs",
    "generate-private-data": "HEALTH_DATA_DIR=data HEALTH_DATA_OUTPUT=src/lib/health-data.private.ts node scripts/generate-data.mjs",
    "privacy-check": "node scripts/privacy-check.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build-private": "VITE_PRIVATE_DATA=true tsc -b && VITE_PRIVATE_DATA=true vite build",
    "preview": "vite preview",
    "test": "vitest",
    "check": "npm run privacy-check && npm run typecheck && npm run test -- --run && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.3",
    "vitest": "^3.2.4"
  }
}
