{
  "name": "family-health-dashboard-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-data": "node scripts/generate-data.mjs",
    "generate-demo-data": "node scripts/generate-data.mjs --mode demo",
    "generate-private-data": "node scripts/generate-data.mjs --mode private --data-dir data",
    "generate-private-ci-data": "node scripts/generate-data.mjs --mode private --data-dir examples/private-ci-data",
    "privacy-check": "node scripts/privacy-check.mjs --scope staged",
    "privacy-check:demo-artifact": "node scripts/privacy-check.mjs --scope artifact --artifact dist-demo --expected-mode demo",
    "privacy-check:private-artifact": "node scripts/privacy-check.mjs --scope artifact --artifact dist-private --expected-mode private",
    "dev": "vite",
    "build": "npm run build-demo",
    "build-demo": "VITE_BUILD_MODE=demo tsc -b && VITE_BUILD_MODE=demo vite build",
    "build-private": "VITE_BUILD_MODE=private VITE_AUTH_ENABLED=true tsc -b && VITE_BUILD_MODE=private VITE_AUTH_ENABLED=true vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:server": "python3 -m unittest discover -s server/tests -p 'test_*.py'",
    "lint": "tsc --noEmit",
    "check": "npm run privacy-check && npm run lint && npm run typecheck && npm run test:scripts && npm run test && npm run test:server && npm run build-demo && npm run privacy-check:demo-artifact",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.3",
    "vitest": "^3.2.4"
  }
}
